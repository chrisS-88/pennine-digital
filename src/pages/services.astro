---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Chevron from "../components/icons/Chevron.astro";
import Slope from "../components/section-dividers/Slope.astro";
---

<BaseLayout title="Services | Pennine Digital">
  <!-- HERO -->
  <section class="pt-40 pb-24">
    <div class="max-w-lg px-6 mx-auto">
      <div data-animate="fade-up" class="flex items-center gap-4 mb-4"></div>

      <h1 data-animate="fade-up" data-delay="100" class="text-5xl md:text-6xl max-w-sm font-heading leading-tight text-brand-900">
        Websites designed around
        <span class="text-accent">your business</span>
      </h1>

      <p data-animate="fade-up" data-delay="200" class="mt-8 max-w-md text-brand-900/70 leading-relaxed">
        Every website is planned, designed and built from scratch to reflect your business, build trust with customers, and make it easier
        for people to get in touch.
      </p>
    </div>
  </section>

  <!-- PLANNING -->
  <section class="py-24">
    <div class="max-w-lg px-6 mx-auto">
      <div data-animate="fade-up" class="flex items-center gap-4 mb-4">
        <div class="h-px w-10 bg-brand-900/10"></div>

        <p class="text-xs tracking-[0.15em] uppercase text-accent">01 · Planning</p>
      </div>

      <h2 data-animate="fade-up" data-delay="100" class="text-3xl md:text-4xl max-w-md font-heading text-brand-900">
        Every website starts with understanding your business.
      </h2>

      <p data-animate="fade-up" data-delay="200" class="mt-4 max-w-md text-brand-900/70">
        Before anything is designed, I take the time to understand your business, your customers, and what the website needs to achieve.
      </p>

      <div class="mt-12 space-y-10">
        <div data-animate="fade-up" data-delay="300" class="grid grid-cols-[3rem_1fr] gap-x-6 items-baseline">
          <Chevron class="text-brand-800 w-3 h-3" />

          <div>
            <h3 class="font-heading text-xl text-brand-800">Your business</h3>

            <p class="mt-2 text-brand-900/70 leading-relaxed">
              Understanding what you do, the services you offer, and what makes your business different.
            </p>
          </div>
        </div>

        <div data-animate="fade-up" data-delay="400" class="grid grid-cols-[3rem_1fr] gap-x-6 items-baseline">
          <Chevron class="text-brand-900/70 w-3 h-3" />

          <div>
            <h3 class="font-heading text-xl text-brand-800">Your customers</h3>

            <p class="mt-2 text-brand-900/70 leading-relaxed">
              Identifying who visits your website and what information they need before getting in touch.
            </p>
          </div>
        </div>

        <div data-animate="fade-up" data-delay="500" class="grid grid-cols-[3rem_1fr] gap-x-6 items-baseline">
          <Chevron class="text-brand-900/70 w-3 h-3" />

          <div>
            <h3 class="font-heading text-xl text-brand-800">Your goals</h3>

            <p class="mt-2 text-brand-900/70 leading-relaxed">
              Whether that's generating more enquiries, showcasing completed work, or creating a stronger online presence.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DESIGN -->
  <section class="py-24 bg-brand-800">
    <div class="max-w-5xl px-6 mx-auto grid gap-16 md:grid-cols-[1.2fr_1fr]">
      <div>
        <div data-animate="fade-up" class="flex items-center gap-4 mb-4">
          <div class="h-px w-10 bg-brand-100/10"></div>

          <p class="text-xs tracking-[0.15em] uppercase text-accent">02 · Design</p>
        </div>

        <h2 data-animate="fade-up" data-delay="100" class="text-3xl md:text-4xl font-heading text-brand-100">
          Designed around your business, not a template.
        </h2>

        <p data-animate="fade-up" data-delay="200" class="mt-4 text-brand-100/70 max-w-md">
          Every layout is designed from scratch to reflect your business, guide visitors through your services, and make it easy for them to
          get in touch.
        </p>
      </div>

      <div>
        <div data-animate="fade-up" data-delay="300" class="py-6 border-b border-brand-100/10">
          <h3 class="font-heading text-xl text-brand-100/90 mb-2">Custom layouts</h3>

          <p class="max-w-sm text-brand-100/70">
            No off-the-shelf themes or page builders. Every page is designed specifically for your business.
          </p>
        </div>

        <div data-animate="fade-up" data-delay="400" class="py-6 border-b border-brand-100/10">
          <h3 class="font-heading text-xl text-brand-100/90 mb-2">Clear messaging</h3>

          <p class="max-w-sm text-brand-100/70">
            Content is organised to help visitors quickly understand your services and why they should choose you.
          </p>
        </div>

        <div data-animate="fade-up" data-delay="500" class="py-6">
          <h3 class="font-heading text-xl text-brand-100/90 mb-2">Built for trust</h3>

          <p class="max-w-sm text-brand-100/70">
            Reviews, imagery, calls to action and supporting content are placed where they make the biggest impact.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- DEVELOPMENT -->
  <section class="py-24 relative">
    <Slope class="absolute top-0" colour="#27272a" />
    <div class="max-w-lg px-6 mx-auto">
      <div data-animate="fade-up" class="flex items-center gap-4 mb-4">
        <div class="h-px w-10 bg-brand-900/10"></div>

        <p class="text-xs tracking-[0.15em] uppercase text-accent">03 · Development</p>
      </div>

      <h2 data-animate="fade-up" data-delay="100" class="text-3xl md:text-4xl font-heading text-brand-900">
        Built properly from the ground up.
      </h2>

      <p data-animate="fade-up" data-delay="200" class="mt-4 max-w-md text-brand-900/70">
        Your website is developed with performance, reliability, and long-term usability in mind — without unnecessary features or bloated
        code.
      </p>

      <div class="mt-12">
        <div
          data-animate="fade-up"
          data-delay="300"
          class="py-6 grid grid-cols-[3rem_1fr] gap-x-6 items-baseline border-b border-brand-900/10">
          <Chevron class="text-brand-800 w-3 h-3" />

          <div>
            <h3 class="font-heading text-xl text-brand-800">Fast performance</h3>

            <p class="mt-2 text-brand-900/70 leading-relaxed">
              Lightweight builds that load quickly and provide a smooth experience across devices.
            </p>
          </div>
        </div>

        <div
          data-animate="fade-up"
          data-delay="400"
          class="py-6 grid grid-cols-[3rem_1fr] gap-x-6 items-baseline border-b border-brand-900/10">
          <Chevron class="text-brand-800 w-3 h-3" />

          <div>
            <h3 class="font-heading text-xl text-brand-900">Mobile-first build</h3>

            <p class="mt-2 text-brand-900/70 leading-relaxed">
              Designed around how most customers browse today — quickly, locally, and from their phones.
            </p>
          </div>
        </div>

        <div data-animate="fade-up" data-delay="500" class="py-6 grid grid-cols-[3rem_1fr] gap-x-6 items-baseline">
          <Chevron class="text-brand-800 w-3 h-3" />

          <div>
            <h3 class="font-heading text-xl text-brand-800">Clean foundations</h3>

            <p class="mt-2 text-brand-900/70 leading-relaxed">
              A solid technical foundation that makes future updates and improvements straightforward.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PERFORMANCE -->
  <section class="py-24">
    <div class="max-w-lg px-6 mx-auto">
      <div data-animate="fade-up" class="flex items-center gap-4 mb-4">
        <div class="h-px w-10 bg-brand-900/10"></div>

        <p class="text-xs tracking-[0.15em] uppercase text-accent">04 · Performance</p>
      </div>

      <h2 data-animate="fade-up" data-delay="100" class="text-3xl md:text-4xl font-heading text-brand-900">
        Built to perform from day one.
      </h2>

      <p data-animate="fade-up" data-delay="200" class="mt-4 max-w-md text-brand-900/70">
        A website should not just look good. It should load quickly, work smoothly, and give customers confidence when they visit.
      </p>

      <div class="mt-12 grid md:grid-cols-3 gap-6">
        <div data-animate="fade-up" data-delay="300" class="border border-brand-900/10 p-6">
          <p class="text-xs tracking-[0.15em] uppercase text-accent mb-3">Speed</p>

          <h3 class="font-heading text-xl text-brand-800">Fast loading pages</h3>

          <p class="mt-2 text-brand-900/70 leading-relaxed">
            Optimised images, clean code, and lightweight builds help your website load quickly across devices.
          </p>
        </div>

        <div data-animate="fade-up" data-delay="400" class="border border-brand-900/10 p-6">
          <p class="text-xs tracking-[0.15em] uppercase text-accent mb-3">Search</p>

          <h3 class="font-heading text-xl text-brand-800">Strong SEO foundations</h3>

          <p class="mt-2 text-brand-900/70 leading-relaxed">
            Pages are structured clearly with the essentials needed for search engines to understand your business.
          </p>
        </div>

        <div data-animate="fade-up" data-delay="500" class="border border-brand-900/10 p-6">
          <p class="text-xs tracking-[0.15em] uppercase text-accent mb-3">Experience</p>

          <h3 class="font-heading text-xl text-brand-800">Designed for real customers</h3>

          <p class="mt-2 text-brand-900/70 leading-relaxed">
            Clear layouts, accessible design, and simple navigation help visitors find what they need quickly.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- LAUNCH -->
  <section class="py-24">
    <div class="max-w-lg px-6 mx-auto">
      <div data-animate="fade-up" class="flex items-center gap-4 mb-4">
        <div class="h-px w-10 bg-brand-900/10"></div>

        <p class="text-xs tracking-[0.15em] uppercase text-accent">05 · Launch & Support</p>
      </div>

      <h2 data-animate="fade-up" data-delay="100" class="text-3xl md:text-4xl font-heading text-brand-900">
        Ready to launch. Supported beyond day one.
      </h2>

      <p data-animate="fade-up" data-delay="200" class="mt-4 max-w-md text-brand-900/70">
        Once your website is complete, I'll make sure everything is tested, connected, and ready for customers to use.
      </p>

      <div class="mt-12">
        <div data-animate="fade-up" data-delay="300" class="py-8 border-b border-brand-900/10">
          <h3 class="font-heading text-xl text-brand-900">Your website, your choice</h3>

          <p class="mt-2 text-brand-900/70 leading-relaxed">
            Your website belongs to you. You can manage your own hosting, or choose ongoing support if you'd prefer me to handle the
            technical side.
          </p>
        </div>

        <div data-animate="fade-up" data-delay="400" class="py-8">
          <h3 class="font-heading text-xl text-brand-900">Ongoing support available</h3>

          <p class="mt-2 text-brand-900/70 leading-relaxed">
            Managed hosting and care plans are available for businesses who want updates, maintenance, and peace of mind after launch.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-32">
    <div class="max-w-lg px-6 mx-auto">
      <div data-animate="fade-up" class="flex items-center gap-4 mb-4">
        <div class="h-px w-10 bg-brand-900/10"></div>

        <p class="text-xs tracking-[0.15em] uppercase text-accent">Start a project</p>
      </div>

      <h2 data-animate="fade-up" data-delay="100" class="text-3xl md:text-4xl font-heading text-brand-900">
        Have a website project in mind?
      </h2>

      <p data-animate="fade-up" data-delay="200" class="mt-5 max-w-md text-brand-900/70 leading-relaxed">
        Whether you need a new website or you're looking to improve an existing one, I'll help you find the right approach for your
        business.
      </p>

      <div data-animate="fade-up" data-delay="300" class="mt-10">
        <Button href="/contact" title="Start Your Project" variant="main" />
      </div>
    </div>
  </section>
</BaseLayout>
