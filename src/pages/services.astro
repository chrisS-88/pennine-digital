---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Responsive from "../components/icons/Responsive.astro";
import Speed from "../components/icons/Speed.astro";
import Feather from "../components/icons/Feather.astro";

const faqs = [
  {
    question: "How long does a website take to build?",
    answer: "Most one‑page sites take around 1–2 weeks, and full websites take 3–5 weeks depending on content and feedback.",
  },
  {
    question: "Do I need to provide the text and photos?",
    answer:
      "Yes — you know your business best. I’ll guide you on what to write and how much you need, and I can tidy up wording if needed.",
  },
  {
    question: "Can I update the website myself?",
    answer:
      "Most small businesses don’t need a CMS, so I handle updates for you. If you’re on the Monthly Care Plan, you get up to two small content updates each month — perfect for keeping things fresh.",
  },
  {
    question: "What’s included in the Monthly Care Plan?",
    answer:
      "Hosting, security updates, backups, uptime monitoring and up to two small content updates per month. It keeps your site running smoothly without you needing to worry about anything technical.",
  },
  {
    question: "What counts as a small content update?",
    answer:
      "Small updates include things like swapping photos, updating text, adding a testimonial or changing opening hours. Larger changes — such as new pages, redesigns or new features — are quoted separately.",
  },
  {
    question: "How does payment work?",
    answer: "A 50% deposit secures your project, and the remaining 50% is due when the site goes live.",
  },
  {
    question: "What’s the process?",
    answer: [
      "Quick chat about your business",
      "You send over content (text + photos)",
      "I design and build your website",
      "You review and request tweaks",
      "We launch the site",
      "Optional care plan begins",
    ],
    isList: true,
  },
  {
    question: "Do you work with businesses outside Yorkshire?",
    answer: "Yes — I’m based in West Yorkshire, but I’m happy to work with businesses anywhere in the UK.",
  },
];
---

<BaseLayout title="Pennine Digital - Services">
  <section class="bg-primary pt-44 pb-24">
    <div class="px-6 max-w-lg mx-auto">
      <p class="text-sm uppercase tracking-widest text-highlight mb-2">What I Do</p>
      <h1 class="text-4xl md:text-5xl font-heading font-semibold text-brand-200 max-w-sm">
        Simple, modern websites shaped around <span class="italic">your business.</span>
      </h1>

      <p class="mt-10 text-brand-200/80 text-xl font-thin leading-relaxed max-w-sm">
        I design and build websites that are clear to use, quick to load, and shaped around how your business actually works. Each one is
        built by hand, keeping things lightweight, intentional, and free from the noise of templates or unnecessary extras.
      </p>
    </div>
  </section>

  <section class="relative z-10">
    <div class="px-6 max-w-md mx-auto text-center py-24">
      <h2 class="text-center font-heading text-3xl mb-10 text-brand-900">A straightforward, personal approach.</h2>

      <p class="leading-relaxed text-xl font-thin">
        When we work together, you’re speaking directly with the person writing the code, shaping the design, and guiding the project. It
        means clearer conversations, quicker decisions, and a more considered website at the end of it.
      </p>
    </div>

    <div class="w-full h-px bg-brand-900/10"></div>
  </section>

  <section class="py-24 bg-[linear-gradient(160deg,_#062a2905_50%,_#fff_50%)]">
    <div class="max-w-lg px-6 mx-auto grid md:grid-cols-2 gap-24">
      <div>
        <p class="text-sm uppercase tracking-widest text-accent">Service 01</p>
        <h2 class="font-heading text-brand-900 text-2xl mb-6">
          <span class="block text-8xl lg:text-9xl font-black leading-none">Custom</span>
          <span class="italic underline underline-offset-4">Web Design</span>
        </h2>
      </div>

      <div class="md:mt-36">
        <p class="mb-10 text-xl font-medium max-w-prose text-brand-700">
          A design process that begins with understanding your goals and ends with a website that feels genuinely yours.
        </p>

        <ul class="space-y-5 border-t border-brand-200 pt-6">
          <li class="flex items-start gap-4">
            <span class="block w-4 h-[2px] bg-accent mt-[10px]"></span>
            <span class="tracking-wider text-brand-700">Responsive, device‑ready layouts</span>
          </li>
          <li class="flex items-start gap-4">
            <span class="block w-4 h-[2px] bg-accent mt-[10px]"></span>
            <span class="tracking-wider text-brand-700">Clean, editorial typography</span>
          </li>
          <li class="flex items-start gap-4">
            <span class="block w-4 h-[2px] bg-accent mt-[10px]"></span>
            <span class="tracking-wider text-brand-700">Simple, accessible navigation</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="py-24 lg:pt-44 bg-brand-800 text-brand-100/80">
    <div class="max-w-lg px-6 mx-auto">
      <div>
        <p class="text-sm uppercase tracking-widest text-accent">Service 02</p>
        <h2 class="font-heading text-brand-100 text-4xl mb-6">Performance Optimisation</h2>
        <div class="space-y-8 max-w-md">
          <p>
            A fast site isn’t a luxury — it’s essential. I build with speed and technical clarity in mind from the very beginning, ensuring
            your site loads quickly, feels responsive, and performs reliably across all devices.
          </p>

          <p>
            This means focusing on efficient code, lightweight assets, and a build process that avoids unnecessary bloat. The result is a
            site that feels smooth, stable, and effortless for your customers to use — even on slower connections.
          </p>
        </div>
      </div>

      <div class="mt-24 grid grid-cols-3 mx-auto text-center">
        <div class="flex flex-col items-center space-y-3">
          <Speed class="w-12" />
          <p class="text-xl font-heading tracking-widest text-brand-100">Fast</p>
        </div>

        <div class="flex flex-col items-center space-y-3">
          <Feather class="w-12" />
          <p class="text-xl font-heading tracking-widest text-brand-100">Light</p>
        </div>

        <div class="flex flex-col items-center space-y-3">
          <Responsive class="w-12" />
          <p class="text-xl font-heading tracking-widest text-brand-100">Flexible</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 bg-brand-50">
    <div class="max-w-lg px-6 mx-auto">
      <p class="text-sm uppercase tracking-widest text-accent">Service 03</p>

      <h2 class="font-heading text-brand-900 text-4xl mb-6">Integrations</h2>

      <p class="text-brand-900/80 leading-relaxed mb-16 max-w-xl">
        Connecting your website to the tools your business relies on — creating a smoother, more joined‑up experience for you and your
        customers.
      </p>

      <div class="grid md:grid-cols-3 gap-14">
        <div class="border border-brand-900/10 p-6">
          <h3 class="text-xl font-light text-brand-900 mb-3">Booking Systems</h3>
          <p class="text-brand-900/80 leading-relaxed">
            Seamless integrations with the booking tools you already use, keeping everything running smoothly.
          </p>
        </div>

        <div class="border border-brand-900/10 p-6">
          <h3 class="text-xl font-light text-brand-900 mb-3">Payments & Checkouts</h3>
          <p class="text-brand-900/80 leading-relaxed">
            Simple, secure payment connections that make it easy for customers to buy or book online.
          </p>
        </div>

        <div class="border border-brand-900/10 p-6">
          <h3 class="text-xl font-light text-brand-900 mb-3">Email & Customer Tools</h3>
          <p class="text-brand-900/80 leading-relaxed">
            Integrations that link your site with your email platform or customer system, keeping everything organised.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24">
    <div class="max-w-md mx-auto">
      <h2 class="text-center font-heading text-3xl mb-10 text-brand-900">Frequently Asked Questions</h2>

      <div class="space-y-8">
        {
          faqs.map((faq) => (
            <div class=" p-6 border-b border-brand-300">
              <h3 class="font-semibold text-lg mb-2">{faq.question}</h3>

              {faq.isList ? (
                <ul class="space-y-2 mt-2">
                  {faq.answer.map((step) => (
                    <li class="flex items-center gap-2">
                      <span class="text-accent font-bold leading-6">•</span>
                      <span>{step}</span>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="leading-relaxed">{faq.answer}</p>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-primary text-brand-200 text-center">
    <div class="max-w-md mx-auto px-6 py-28">
      <h2 class="font-heading text-4xl mb-6">Ready to start your project?</h2>

      <p class="leading-relaxed text-brand-200/80 max-w-xl mx-auto">
        Whether you have a clear plan or just an idea, I’d love to hear what you’re working on. No pressure — just a friendly chat about
        what you need.
      </p>

      <div class="mt-10 flex flex-col items-center gap-2">
        <Button href="/contact" title="Start Your Project" variant="ghost" />
        <p class="text-sm mt-4 text-brand-200/70">No obligation — just a quick conversation.</p>
      </div>
    </div>
  </section>
</BaseLayout>
