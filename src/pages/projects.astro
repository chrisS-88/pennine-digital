---
import Button from "../components/Button.astro";
import Chevron from "../components/icons/Chevron.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Work | Pennine Digital">
  <section class="relative min-h-[80vh] pt-40 pb-24 overflow-hidden">
    <div class="max-w-lg px-6 mx-auto">
      <h1 data-animate="fade-up" data-delay="100" class="text-5xl md:text-6xl font-heading leading-tight text-brand-900">
        Real examples are
        <span class="text-accent">coming soon</span>
      </h1>

      <p data-animate="fade-up" data-delay="200" class="mt-8 max-w-md text-brand-900/70 leading-relaxed">
        I'm currently building a collection of websites for Yorkshire trades and local service businesses. This page will showcase completed
        projects, the challenges solved, and the results achieved.
      </p>

      <div data-animate="fade-up" data-delay="300" class="mt-12 border-t border-brand-900/10 pt-8">
        <p class="text-xs uppercase tracking-[0.15em] text-brand-900/50 mb-6">Currently building</p>

        <div class="space-y-5">
          <div data-animate="fade-up" data-delay="400" class="grid grid-cols-[3rem_1fr] gap-6">
            <Chevron class="text-brand-900/70 mt-[10px] w-3 h-3" />

            <div>
              <h2 class="font-heading text-xl text-brand-900">Trade websites</h2>

              <p class="mt-1 text-brand-900/70">Fast, professional websites designed to turn visitors into enquiries.</p>
            </div>
          </div>

          <div data-animate="fade-up" data-delay="500" class="grid grid-cols-[3rem_1fr] gap-6">
            <Chevron class="text-brand-900/70 mt-[10px] w-3 h-3" />

            <div>
              <h2 class="font-heading text-xl text-brand-900">Local service businesses</h2>

              <p class="mt-1 text-brand-900/70">Clear websites built around services, locations, and customer trust.</p>
            </div>
          </div>

          <div data-animate="fade-up" data-delay="600" class="grid grid-cols-[3rem_1fr] gap-6">
            <Chevron class="text-brand-900/70 mt-[10px] w-3 h-3" />

            <div>
              <h2 class="font-heading text-xl text-brand-900">Bespoke solutions</h2>

              <p class="mt-1 text-brand-900/70">Custom builds tailored around each business rather than generic templates.</p>
            </div>
          </div>
        </div>
      </div>

      <div data-animate="fade-up" data-delay="700" class="mt-12 flex flex-col sm:flex-row gap-4">
        <Button href="/contact" title="Start Your Project" variant="main" />

        <Button href="/" title="Back Home" variant="ghost" />
      </div>
    </div>
  </section>
</BaseLayout>
