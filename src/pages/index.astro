---
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Accordion from "../components/Accordion.astro";
import Chevron from "../components/icons/Chevron.astro";

const websiteBenefits = [
  {
    title: "Fast loading",
    description: "Lightweight websites that load quickly on every device.",
  },
  {
    title: "Mobile-first design",
    description: "Built for customers searching, calling, and requesting quotes on their phones.",
  },
  {
    title: "Clear messaging",
    description: "Straightforward content that explains what you do and why customers should choose you.",
  },
  {
    title: "Built to convert",
    description: "Clear calls-to-action that encourage more enquiries, calls, and quote requests.",
  },
  {
    title: "Local search ready",
    description: "Structured to support your services, locations, and visibility in local search.",
  },
  {
    title: "Simple ownership",
    description: "A one-off project with optional ongoing support if you ever need it.",
  },
];

const industries = [
  "Roofers",
  "Electricians",
  "Plumbers",
  "Joiners",
  "Landscapers",
  "Gardeners",
  "Decorators",
  "Driveways",
  "Cleaning Services",
  "Handymen",
  "...and more",
];

const pricingPlans = [
  {
    title: "Launch",
    price: 495,
    description: "A professional one-page website for new businesses that need a strong online presence without unnecessary complexity.",
    includes: [
      "Single bespoke landing page",
      "Mobile-first design",
      "Fast, SEO-ready build",
      "Contact form & click-to-call",
      "Google Maps integration",
      "2 weeks of post-launch support",
    ],
  },
  {
    title: "Enquiry",
    price: 1295,
    description: "A bespoke multi-page website designed to build trust, improve visibility and generate more customer enquiries.",
    featured: true,
    includes: [
      "Up to 8 bespoke pages",
      "Everything in Launch",
      "Conversion-focused layouts",
      "Service & location pages",
      "Reviews & FAQ sections",
      "30 days of post-launch support",
    ],
  },
  {
    title: "Custom",
    price: "1,995",
    prefix: "From",
    description: "A tailored website solution for established businesses with more advanced requirements and functionality.",
    includes: [
      "Everything in Enquiry",
      "Additional pages",
      "Advanced enquiry forms",
      "Third-party integrations",
      "Custom functionality",
      "Priority planning & support",
    ],
  },
];

const faqs = [
  {
    question: "How long does a website take to build?",
    answer:
      "Most websites are completed within 2–4 weeks, depending on the size of the project and how quickly content, images, and feedback are provided.",
  },
  {
    question: "What do you need from me to get started?",
    answer:
      "We'll start with a quick chat about your business, customers, and goals. I'll then guide you through what content, images, and information are needed to build your website.",
  },
  {
    question: "Do you write the website content?",
    answer:
      "If you already have content, I can work with that. If not, I can help create clear, customer-focused copy that explains your services and encourages enquiries.",
  },
  {
    question: "Will my website help me get found on Google?",
    answer:
      "Every website is built with strong SEO foundations, including fast performance, mobile-first design, and pages structured around your services and locations. No one can guarantee rankings, but your website will be built with visibility in mind.",
  },
  {
    question: "Do you provide hosting and ongoing support?",
    answer:
      "Yes. You can arrange your own hosting, or choose managed hosting and care plans where I look after updates, maintenance, security, and technical support for you.",
  },
  {
    question: "Am I tied into a contract?",
    answer:
      "No. Your website is a one-off project and belongs to you. Ongoing hosting and support are optional if you want continued help after launch.",
  },
  {
    question: "Do you only work with Yorkshire businesses?",
    answer: "Yorkshire is my main focus, but I also work with trades and local service businesses across the UK.",
  },
];
---

<BaseLayout title="Pennine Digital">
  <section>
    <Hero />
  </section>

  <!-- FOUNDATIONS -->
  <section class="py-24">
    <div class="max-w-lg px-6 mx-auto">
      <div class="flex items-center gap-4 mb-4">
        <div class="h-px w-10 bg-brand-900/10"></div>

        <p class="font-mono text-xs tracking-[0.3em] uppercase text-accent">01 · Foundations</p>
      </div>
      <h2 class="text-3xl md:text-4xl max-w-md font-heading font-semibold text-brand-900">
        Everything your website needs. Nothing it doesn't.
      </h2>

      <p class="mt-4 max-w-md text-brand-900/70 text-lg">
        Every feature has a purpose — to help customers find your business, trust what they see, and get in touch.
      </p>

      <div class="mt-12 space-y-10">
        {
          websiteBenefits.map((benefit, index) => (
            <div class="grid grid-cols-[2.5rem_1fr] gap-x-6 items-baseline">
              <Chevron class="text-brand-900/70 w-3 h-3" />

              <div>
                <h3 class="font-heading text-xl text-brand-900">{benefit.title}</h3>

                <p class="mt-2 text-brand-900/70 leading-relaxed">{benefit.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section class="py-24">
    <div class="max-w-lg px-6 mx-auto">
      <div class="flex items-center gap-4 mb-4">
        <div class="h-px w-10 bg-brand-900/10"></div>

        <p class="font-mono text-xs tracking-[0.3em] uppercase text-accent">02 · Industries</p>
      </div>

      <h2 class="text-3xl md:text-4xl font-heading font-semibold text-brand-900">Built for the businesses that keep Yorkshire moving.</h2>

      <p class="mt-4 text-lg max-w-md text-brand-900/70">
        From roofers and electricians to landscapers and cleaning companies, I build websites for businesses that rely on local customers
        and word-of-mouth.
      </p>

      <p class="mt-20 text-xs uppercase tracking-[0.2em] text-brand-900/50">Common trades & services include:</p>

      <div class="max-w-md flex flex-wrap gap-3 mt-10 text-sm">
        {
          industries.map((industry) => (
            <span class="px-4 py-2 rounded-full border border-brand-900/10 bg-brand-50 text-brand-900/80">{industry}</span>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="py-24">
    <div class="px-6 max-w-lg mx-auto">
      <div class="">
        <div class="flex items-center gap-4 mb-4">
          <div class="h-px w-10 bg-brand-900/10"></div>

          <p class="font-mono text-xs tracking-[0.3em] uppercase text-accent">03 · Process</p>
        </div>

        <h2 class="text-3xl md:text-4xl font-heading font-semibold text-brand-900">A simple process from first chat to launch.</h2>

        <p class="mt-4 text-lg max-w-md text-brand-900/70">
          No overcomplicated project management or endless back-and-forth. Just a clear, structured process from first chat to launch.
        </p>
      </div>

      <div class="mt-16 max-w-lg mx-auto space-y-12">
        <div class="grid grid-cols-[2.5rem_1fr] items-baseline gap-6">
          <Chevron class="text-brand-900/70 w-3 h-3" />

          <div>
            <h3 class="font-heading text-xl text-brand-900">Quick chat</h3>
            <p class="mt-2 text-brand-900/70">We talk about your business, your customers, and what you want your website to achieve.</p>
          </div>
        </div>

        <div class="grid grid-cols-[2.5rem_1fr] items-baseline gap-6">
          <Chevron class="text-brand-900/70 w-3 h-3" />

          <div>
            <h3 class="font-heading text-xl text-brand-900">Design & build</h3>
            <p class="mt-2 text-brand-900/70">
              I design and build your website with a focus on speed, clarity, and getting more enquiries.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-[2.5rem_1fr] items-baseline gap-6">
          <Chevron class="text-brand-900/70 w-3 h-3" />

          <div>
            <h3 class="font-heading text-xl text-brand-900">Launch</h3>
            <p class="mt-2 text-brand-900/70">We go live. Your site is connected, tested, and ready to bring in new customers.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section class="py-24">
    <div class="max-w-lg px-6 mx-auto">
      <div class="flex items-center gap-4 mb-4">
        <div class="h-px w-10 bg-brand-900/10"></div>

        <p class="font-mono text-xs tracking-[0.3em] uppercase text-accent">04 · Pricing</p>
      </div>

      <h2 class="font-heading text-brand-900 text-3xl md:text-4xl font-semibold">Simple pricing for bespoke websites.</h2>

      <p class="mt-4 text-lg text-brand-900/70 max-w-md">
        Choose the package that best suits your business. Every website is built from scratch, focused on generating enquiries, and tailored
        to your goals.
      </p>
    </div>

    <div class="mt-16 max-w-xl px-6 md:px-16 mx-auto grid gap-8 lg:grid-cols-3">
      {pricingPlans.map((plan, i) => <FeatureCard index={i} {...plan} />)}
    </div>

    <div class="mx-6">
      <div class="mt-20 max-w-lg mx-auto bg-brand-50/40 border border-brand-900/10 rounded-md p-8 md:p-10">
        <div class="flex items-center gap-4 mb-4">
          <div class="h-px w-10 bg-brand-900/10"></div>

          <p class="font-mono text-xs tracking-[0.3em] uppercase text-accent">Support</p>
        </div>

        <h3 class="font-heading text-2xl text-brand-900">Hosting & ongoing support</h3>

        <p class="mt-4 max-w-md text-brand-900/70">
          Your website is yours to manage. If you'd rather not worry about hosting, updates or maintenance, optional monthly plans are
          available.
        </p>

        <div class="mt-10 divide-y divide-brand-900/10">
          <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-6 py-6">
            <div>
              <h4 class="font-heading text-xl text-brand-900">Managed Hosting</h4>

              <p class="mt-2 text-brand-900/70 leading-relaxed">
                Fast, secure hosting with SSL, backups and monitoring to keep your website online and performing reliably.
              </p>
            </div>

            <p class="shrink-0 font-heading text-2xl text-brand-900">
              £12
              <span class="text-sm font-normal text-brand-900/60">/month</span>
            </p>
          </div>

          <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-6 py-6">
            <div>
              <h4 class="font-heading text-xl text-brand-900">Care Plan</h4>

              <p class="mt-2 text-brand-900/70 leading-relaxed">
                Everything in Managed Hosting, plus software updates, maintenance, priority support and small content changes.
              </p>
            </div>

            <p class="shrink-0 font-heading text-2xl text-brand-900">
              £45
              <span class="text-sm font-normal text-brand-900/60">/month</span>
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-16 max-w-lg mx-auto px-6">
      <h3 class="font-heading text-2xl text-brand-900">Need help choosing the right option?</h3>

      <p class="mt-3 max-w-md text-brand-900/70">Tell me a little about your business and I'll recommend the best approach.</p>

      <div class="mt-6">
        <Button href="/contact" title="Start a Conversation" variant="main" />
      </div>
    </div>
  </section>

  <!-- FAQS -->
  <section class="py-24">
    <div class="max-w-lg px-6 mx-auto">
      <div class="flex items-center gap-4 mb-4">
        <div class="h-px w-10 bg-brand-900/10"></div>

        <p class="font-mono text-xs tracking-[0.3em] uppercase text-accent">05 · FAQ</p>
      </div>

      <h2 class="text-3xl md:text-4xl font-heading font-semibold text-brand-900">Common questions.</h2>

      <p class="mt-4 max-w-md text-lg text-brand-900/70">Everything you might want to know before getting started.</p>

      <div class="mt-12">
        <Accordion items={faqs} />
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-32">
    <div class="max-w-lg px-6 mx-auto">
      <div class="flex items-center gap-4 mb-4">
        <div class="h-px w-10 bg-brand-900/10"></div>

        <p class="font-mono text-xs tracking-[0.3em] uppercase text-accent">Start a project</p>
      </div>

      <h2 class="text-3xl md:text-4xl font-heading font-semibold text-brand-900">
        Ready for a website that brings your business more enquiries?
      </h2>

      <p class="mt-5 max-w-md text-lg text-brand-900/70 leading-relaxed">
        Tell me a bit about your business and what you're looking to achieve. I'll get back to you with the best next step.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row gap-4">
        <Button href="/contact" title="Start a Project" variant="main" />

        <Button href="/projects" title="View Work" variant="ghost" />
      </div>
    </div>
  </section>
</BaseLayout>
