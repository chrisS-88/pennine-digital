---
import Button from "./Button.astro";
import Check from "./icons/Check.astro";

const { title, price, prefix, description, includes, index } = Astro.props;
---

<div
  class="relative rounded-md border p-10 text-left transition-colors duration-200 border-brand-900/10 hover:border-brand-900/20 bg-brand-50">
  {index === 1 && <span class="absolute top-4 right-4 text-[10px] uppercase tracking-[0.15em] text-accent">Recommended</span>}

  <h3 class="font-heading text-xl text-brand-900">
    {title}
  </h3>

  {
    price && (
      <p class="mt-4 font-heading text-3xl text-brand-900">
        £{price}
        <span class="ml-1 text-sm font-normal text-brand-900/60">{prefix}</span>
      </p>
    )
  }

  <p class="mt-4 text-brand-900/70 text-sm">
    {description}
  </p>

  {
    includes && (
      <ul class="mt-8 space-y-2 text-xs text-brand-900/70">
        {includes.map((item = "string") => (
          <li class="flex gap-3">
            <Check class="mt-0.5 h-4 w-4 shrink-0 text-accent" />
            <span>{item}</span>
          </li>
        ))}
      </ul>
    )
  }

  <div class="mt-6">
    <Button variant="main" title="Enquire now" href="/contact" />
  </div>
</div>
