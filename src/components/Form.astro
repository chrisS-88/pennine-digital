---

---

<form name="contact" method="POST" action="/success" data-netlify="true" class="w-full">
  <input type="hidden" name="form-name" value="contact" />
  <input type="hidden" name="subject" value="New enquiry from your website" />

  <fieldset class="space-y-8">
    <div class="form-label-div">
      <label for="name">Name</label>

      <input type="text" id="name" name="name" required autocomplete="name" class="form-input" />
    </div>

    <div class="form-label-div">
      <label for="business">Business (optional)</label>

      <input type="text" id="business" name="business" autocomplete="organization" class="form-input" />
    </div>

    <div class="form-label-div">
      <label for="email">Email</label>

      <input type="email" id="email" name="email" required autocomplete="email" class="form-input" />
    </div>

    <div class="form-label-div">
      <label for="message">Tell me about your project</label>

      <textarea
        id="message"
        name="message"
        rows="6"
        required
        class="form-input resize-none"
        placeholder="Tell me a little about your business and what you're looking to achieve."></textarea>
    </div>
  </fieldset>

  <fieldset class="mt-10 border-t border-brand-900/10 pt-8">
    <legend class="font-mono text-[11px] uppercase tracking-[0.25em] text-brand-900/60"> Budget (optional) </legend>

    <!-- Netlify field fix -->
    <input type="hidden" name="budget" />

    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      <label class="flex items-center gap-3 cursor-pointer">
        <input type="radio" id="budget-under" name="budget" value="Under £1,000" class="check-box" />

        <span>Under £1,000</span>
      </label>

      <label class="flex items-center gap-3 cursor-pointer">
        <input type="radio" id="budget-1-2" name="budget" value="£1,000–£2,000" class="check-box" />

        <span>£1,000–£2,000</span>
      </label>

      <label class="flex items-center gap-3 cursor-pointer">
        <input type="radio" id="budget-2plus" name="budget" value="£2,000+" class="check-box" />

        <span>£2,000+</span>
      </label>

      <label class="flex items-center gap-3 cursor-pointer">
        <input type="radio" id="budget-unsure" name="budget" value="Not sure yet" class="check-box" />

        <span>Not sure yet</span>
      </label>
    </div>
  </fieldset>

  <button
    type="submit"
    class="mt-10 inline-flex border border-brand-900/15 px-6 py-3 font-mono text-xs uppercase tracking-[0.25em] text-brand-900 transition-colors hover:border-brand-900/30">
    Send enquiry
  </button>

  <p class="mt-6 text-sm text-brand-900/50">Your details will only be used to reply to your enquiry.</p>
</form>
