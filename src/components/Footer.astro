---
import Chevron from "./icons/Chevron.astro";
import Slope from "./section-dividers/Slope.astro";
---

<footer class="relative bg-brand-800 text-brand-200 py-20">
  <div class="max-w-lg mx-auto px-6">
    <div class="flex items-center gap-4 mb-6">
      <div class="h-px w-10 bg-brand-200/20"></div>

      <p class="text-xs tracking-[0.15em] uppercase text-brand-200/60">Pennine Digital</p>
    </div>

    <h2 class="font-heading text-3xl text-brand-100 leading-tight">Websites built for Yorkshire businesses.</h2>

    <p class="mt-5 max-w-md text-brand-200/70 leading-relaxed">
      Bespoke websites for trades and local service businesses, designed to build trust and generate more enquiries.
    </p>

    <div class="mt-8">
      <p class="mt-3 mb-5 text-brand-200/70 text-sm">Prefer a quick chat? Email me directly or drop me a WhatsApp message anytime.</p>

      <div class="flex flex-col gap-4">
        <div class="group grid grid-cols-[1rem_1fr] w-max gap-x-6 items-baseline">
          <Chevron class="text-brand-200 w-3 h-3 transition group-hover:text-accent" />
          <a href="mailto:hello@penninedigital.co.uk" class="text-sm text-brand-200 transition group-hover:text-accent">
            hello@penninedigital.co.uk
          </a>
        </div>

        <div class="group grid grid-cols-[1rem_1fr] w-max gap-x-6 items-baseline">
          <Chevron class="text-brand-200 w-3 h-3 transition group-hover:text-accent" />
          <a href="https://wa.me/447930971103" target="_blank" class="text-sm text-brand-200 transition group-hover:text-accent">
            Message me on WhatsApp
          </a>
        </div>
      </div>
    </div>

    <div class="mt-12 h-px bg-brand-200/10"></div>

    <div class="mt-8 flex flex-col md:flex-row md:justify-between gap-6 text-xs text-brand-200/60">
      <div class="flex gap-6">
        <a href="/privacy" class="hover:text-accent transition"> Privacy Policy </a>

        <a href="/cookies" class="hover:text-accent transition"> Cookies </a>
      </div>

      <div class="space-y-1 md:text-right">
        <p>© {new Date().getFullYear()} Pennine Digital</p>
        <p class="tracking-wide">Built with Astro</p>
      </div>
    </div>
  </div>
  <Slope class="absolute top-0" colour="#f4f4f5" />
</footer>
