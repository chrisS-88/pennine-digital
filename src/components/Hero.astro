---
import Button from "./Button.astro";
---

<section class="relative hero-grid min-h-[90svh] md:min-h-screen overflow-hidden">
  <div class="relative z-10 flex flex-col justify-center pt-44 gap-12 md:gap-12 px-6 max-w-lg mx-auto">
    <div>
      <div class="flex items-center gap-3 mb-4">
        <span class="h-px w-10 bg-brand-900/10"></span>
        <p class="text-xs font-mono uppercase tracking-[0.3em] text-brand-900/60">Built for Yorkshire Trades</p>
      </div>

      <h1 class="max-w-md text-4xl md:text-5xl font-heading font-semibold leading-tight text-brand-900">
        Websites that generate <span class="inline-block text-accent"> more enquiries</span> for Yorkshire trades
      </h1>

      <p class="mt-8 md:mt-12 max-w-sm text-lg text-brand-900/70">
        Fast, bespoke websites designed to generate more enquiries. No long contracts or agency retainers.
      </p>
    </div>

    <div class="relative flex flex-col sm:flex-row gap-4">
      <Button href="/contact" title="Get a Quote" variant="main" />
      <Button href="/projects" title="View Work" variant="ghost" />
    </div>

    <div class="flex flex-wrap gap-4 text-[10px]">
      <span class="font-mono uppercase tracking-[0.3em] rounded-full border border-brand-900/10 bg-brand-900/5 backdrop-blur-sm px-4 py-2">
        Bespoke</span
      >

      <span class="font-mono uppercase tracking-[0.3em] rounded-full border border-brand-900/10 bg-brand-900/5 backdrop-blur-sm px-4 py-2">
        Fast</span
      >

      <span class="font-mono uppercase tracking-[0.3em] rounded-full border border-brand-900/10 bg-brand-900/5 backdrop-blur-sm px-4 py-2">
        Mobile-first</span
      >
    </div>
  </div>
</section>
