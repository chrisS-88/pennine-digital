---
import Button from "./Button.astro";
---

<section class="relative hero-grid min-h-[100svh] overflow-hidden">
  <div class="relative z-10 flex flex-col justify-center pt-36 gap-8 px-6 max-w-lg mx-auto">
    <div>
      <h1 data-animate="fade-up" data-delay="100" class="max-w-md text-5xl md:text-6xl font-heading leading-tight text-brand-900">
        Websites that bring in <span class="inline-block text-accent"> more enquiries</span> for trades and service businesses
      </h1>

      <p data-animate="fade-up" data-delay="200" class="mt-4 md:mt-6 max-w-sm text-brand-900/70">
        Slow sites lose jobs. Confusing pages push people away. Hard-to-use forms stop good leads. Your website shouldn’t get in the way. It
        should help you win work. Every single day.
      </p>
    </div>

    <div data-animate="fade-up" data-delay="300" class="relative flex flex-col mt-6 sm:flex-row gap-4">
      <Button href="/contact" title="Start your project" variant="main" />
    </div>

    <div class="flex flex-wrap justify-center items-center text-xs md:justify-start text-left gap-2 text-brand-600">
      <span class="uppercase"> Built for trades </span>
      <div class="w-1 h-1 bg-brand-600/60 rounded-full"></div>
      <span class="uppercase"> Build trust </span>
      <div class="w-1 h-1 bg-brand-600/60 rounded-full"></div>
      <span class="uppercase"> Generate enquiries </span>
    </div>
  </div>
</section>
