---
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import WhatsAppFixed from "../components/WhatsAppFixed.astro";
import "../styles/global.css";

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <meta name="description" content="Modern, fast and reliable websites for small businesses across Bradford and West Yorkshire." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://penninedigital.co.uk/" />
    <meta property="og:title" content="Pennine Digital — Fast, Reliable Websites for West Yorkshire" />
    <meta property="og:description" content="Modern, fast and reliable websites for small businesses across Bradford and West Yorkshire." />
    <meta property="og:image" content="https://penninedigital.co.uk/og_img.png" />
    <meta name="google-site-verification" content="VELMEm8NCdUMrka4JSj2wEAJ3cTnsp5SIv7D--ET8Ek" />
    <script type="text/javascript">
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = "https://www.clarity.ms/tag/" + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, "clarity", "script", "xcf9ptvrn2");
    </script>
  </head>
  <body class="text-brand-900/90 bg-brand-100 font-body">
    <Nav />
    <slot />
    <WhatsAppFixed phone="447930971103" />
    <Footer />

    <script>
      import animateIn from "../../pennine-design-system/utils/animate-in.js";
      animateIn();
    </script>
  </body>
</html>
